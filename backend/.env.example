# ---- Database: pick ONE of the three options ----

# 1. A connection string (MySQL or Postgres). TLS is turned on automatically
#    when the URL contains sslmode=require, or with DB_SSL=true.
# DATABASE_URL=mysql://user:password@localhost:3306/pet_marketplace
# DATABASE_URL=postgres://user:password@localhost:5432/pet_marketplace

# 2. SQLite, for trying the app without a database server
# DB_DIALECT=sqlite
# DB_STORAGE=./dev.sqlite

# 3. MySQL from separate settings (used when neither of the above is set)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pet_marketplace
DB_USER=root
DB_PASS=

# ---- Security ----

# Signs session cookies. Use a long random value, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Session cookies are HTTPS-only when NODE_ENV=production. Set to false for a
# production build on plain http://localhost.
# COOKIE_SECURE=false

# Number of proxies in front of the app (1 on Render), for real client IPs.
# TRUST_PROXY=1

# ---- Server ----

# Frontend origin(s) allowed to call the API in development, comma-separated
CORS_ORIGIN=http://localhost:3000

# Serve the built React app from this folder (production / Docker)
# FRONTEND_DIR=../frontend/build

# Set to false to skip applying migrations on start
# RUN_MIGRATIONS=true

PORT=5000
