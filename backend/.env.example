# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pet_marketplace
DB_USER=root
DB_PASS=

# Signs session cookies. Use a long random value, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Frontend origin(s) allowed to call the API, comma-separated
CORS_ORIGIN=http://localhost:3000

PORT=5000
